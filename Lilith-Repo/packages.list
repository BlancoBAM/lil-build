# Lilith Linux Repository - Simplified Package List
# For use with build_lilith_repo.py
# Format: source|package|component|description

# === LILITH CORE COMPONENTS (Core Component - Installed by Default) ===
local|offerings|core|Unified package manager GUI
local|tweakers|core|System optimization and tweaks
local|lilim|core|AI Assistant with persistent memory
local|s8n-system|core|Lilith System Package Manager CLI wrapper
local|lilith-tts|core|Text-to-Speech Engine
local|stake|core|Lilith Stake CLI tool
local|ouija-pad|core|Simple text editor
local|browseros|core|Lilith Default Web Browser OS AppImage
local|hyper-terminal|core|Hyper terminal emulator for Lilith Linux
local|hellfire|core|HellFire Distro Tool
local|vicinae|core|Vicinae Visual Workspace AppImage
local|soar|core|Soar Package Manager wrapper
local|astral-uv|core|Astral uv python package manager wrapper
local|pacstall-wrapper|core|Pacstall Package Manager wrapper
local|fluent-icon-theme-installer|core|Fluent icon theme installer wrapper
local|pling-store-wrapper|core|Pling-Store Client wrapper
local|script-kit-wrapper|core|Script-Kit Desktop Application wrapper
local|cosmic-uniform-glass-theme-installer|core|Cosmic Uniform Glass Theme installer

# === LILITH RECOMMENDED EXTRA COMPONENTS (Xtra Component - Curated Optional) ===
local|ferdium|xtra|Ferdium Desktop multi-service visual app
local|nixite|xtra|Nixite Text Editor
local|cosmic-connect|xtra|COSMIC Connect KDE Connect integration applet
local|linuxtoys|xtra|Collection of toys for terminal
local|homepage|xtra|Homepage browser start page dashboard
local|bashsenpai|xtra|BashSenpai Terminal AI assistant
local|open-interpreter|xtra|Open Interpreter local AI agent executor
local|keygeist|xtra|Keygeist SSH agent UI manager
local|waveterm|xtra|Waveterm visual terminal emulator
local|webi-installers|xtra|Webi easy terminal installer package
local|lux-wine|xtra|Lux Wine integration wrapper
local|startwine-launcher|xtra|StartWine Wine Launcher GUI
local|icebreaker|xtra|Icebreaker system diagnostic utility
local|rustation|xtra|Rustation PlayStation emulator
local|noctua|xtra|Noctua dark mode web app dashboard
local|super-stt|xtra|Super-STT speech transcription offline service
local|subscribi|xtra|Subscribi subscription GUI manager
local|espanso-gui|xtra|Espanso text expander GUI
local|lotti|xtra|Lotti system indicator and widgets app
local|brief|xtra|Brief markdown editing app
local|wonderpen|xtra|Wonderpen professional writing editor
local|digikam|xtra|Digikam photography asset management software
local|spacedrive|xtra|Spacedrive cross-platform file explorer

# === SYSTEM DEPENDENCIES ===
apt|build-essential|core|Build tools
apt|cargo|core|Rust package manager
apt|rustc|core|Rust compiler
apt|libssl-dev|core|SSL development files
apt|pkg-config|core|Package configuration tool
apt|libwayland-dev|core|Wayland development files
apt|libseat-dev|core|Seat management library
apt|libxkbcommon-dev|core|XKB common library
apt|libinput-dev|core|Input device library
apt|libgtk-3-dev|core|GTK3 development files
apt|libfontconfig1-dev|core|Font configuration development
apt|libxcb1-dev|core|XCB development files
apt|cmake|core|CMake build system
apt|nodejs|core|JavaScript runtime
apt|flatpak|core|Flatpak application sandbox support
apt|gnome-software-plugin-flatpak|core|Software center flatpak plugin
apt|libfuse2t64|core|FUSE 2 filesystem support library
